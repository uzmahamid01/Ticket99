# Ticket99 environment template.
#
# Copy to .env and fill in the values for your local LAMP runtime.
# .env is git-ignored; this template is committed and must stay value-free.

# Database connection
TICKET99_DB_HOST=
TICKET99_DB_PORT=
TICKET99_DB_USER=
TICKET99_DB_PASSWORD=
TICKET99_DB_NAME=

# Site presentation
TICKET99_PAGE_TITLE=
TICKET99_WEBSITE_URL=
